{
  "name": "subtracker-backend",
  "version": "1.0.0",
  "description": "API do SubTracker - integração Pluggy e persistência de assinaturas",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:recorrencia": "node scripts/migrate-recorrencia.js",
    "avaliar": "node -r ts-node/register/transpile-only scripts/avaliar-heuristica.ts",
    "sandbox": "node -r ts-node/register/transpile-only scripts/testar-sandbox.ts",
    "avaliar:teste": "node -r ts-node/register/transpile-only scripts/avaliar-teste.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "pluggy-sdk": "^0.83.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
