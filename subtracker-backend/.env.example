PORT=3000

PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Banco local: preencha DB_PASSWORD (e ajuste host/porta se precisar).
DB_USER=postgres
DB_HOST=localhost
DB_NAME=subtracker_db
DB_PASSWORD=
DB_PORT=5432

# Banco na nuvem (Neon, Supabase, Render Postgres): use só a connection string.
# Quando definida, substitui as variáveis DB_* acima e liga SSL automaticamente.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Origens permitidas no CORS (separadas por vírgula, sem barra no final)
# Local: http://localhost:5173 | Produção: https://seu-site.vercel.app
CORS_ORIGIN=http://localhost:5173

# A API escuta só nesta máquina. Em hospedagem (Render etc.) use 0.0.0.0.
HOST=127.0.0.1

# Código de acesso. Se definido, toda rota (menos /api/health) exige o cabeçalho x-access-token,
# e o site pede o código na primeira vez. OBRIGATÓRIO ao publicar a API na internet.
# ACCESS_TOKEN=escolha-um-codigo-longo

# true mostra o botão "Baixar extrato" e libera a rota do CSV. Deixe false na apresentação.
EXTRATO_EXPORT=false

# Sandbox e avaliação: por padrão só em HOST local. Em hospedagem defina true para usar
# o gerador de cenários e o Modo TCC; false para desligar.
# SANDBOX_API=true
# AVALIACAO_API=true
