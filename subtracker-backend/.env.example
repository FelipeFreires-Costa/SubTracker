PORT=3000

PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

DB_USER=postgres
DB_HOST=localhost
DB_NAME=subtracker_db
DB_PASSWORD=
DB_PORT=5432

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# A API escuta só nesta máquina. Use 0.0.0.0 apenas se precisar abrir para a rede.
HOST=127.0.0.1

# true mostra o botão "Baixar extrato" e libera a rota do CSV. Deixe false na apresentação.
EXTRATO_EXPORT=false
